{
 "model": "ath_h2_stand_v3.onnx",
 "status": "v3 final (= best eval) stand policy; FAILS float64 oracle: 8/8 falls within 1.5-3.1 s. Display/demo only.",
 "onnx": {
  "input": "obs float32 [batch,93] (raw, un-normalized; normalization is inside the graph)",
  "output": "action float32 [batch,29] in [-1,1] (deterministic tanh(mean))"
 },
 "obs_layout": [
  {
   "slice": [
    0,
    3
   ],
   "name": "gravity_in_base",
   "formula": "R_base^T @ [0,0,-1], R_base = data.xmat of the pelvis/free body (body id 1)"
  },
  {
   "slice": [
    3,
    6
   ],
   "name": "base_angvel",
   "formula": "data.qvel[3:6] (MuJoCo free-joint angular velocity, local frame, rad/s)"
  },
  {
   "slice": [
    6,
    35
   ],
   "name": "joint_pos_offset",
   "formula": "data.qpos[7:36] - Q0"
  },
  {
   "slice": [
    35,
    64
   ],
   "name": "joint_vel_scaled",
   "formula": "0.1 * data.qvel[6:35]"
  },
  {
   "slice": [
    64,
    93
   ],
   "name": "last_action",
   "formula": "previous policy output (zeros at reset)"
  }
 ],
 "action_to_ctrl": "ctrl = clip(Q0 + 0.3*action, ctrl_lo, ctrl_hi); position-servo targets, actuator order = joint order below",
 "control": {
  "policy_hz": 50,
  "physics_timestep_s": 0.002,
  "substeps_per_action": 10,
  "solver": "Newton, elliptic cone, trained at iterations 4 / ls 8 (MJX f32); oracle at 100/50 f64"
 },
 "init": "qpos = keyframe \"home\" of h2.xml (+ U(-0.05,0.05) joint noise in training)",
 "termination": "base z < 0.65 m or base up-vector z < 0.6",
